# Eye candy for the glass terminal (TikTok rice). Own file so iNiR never touches it.
if status is-interactive
    # Falling katakana + symbols. Colors: green red blue white yellow cyan magenta.
    alias matrix 'unimatrix -a -n -l kS -c cyan -s 93'
    # Thin square pipes in the terminal palette (from the wallpaper).
    alias pipes 'pipes.sh -t 2 -p 4 -R -r 4000 -f 60'
end
