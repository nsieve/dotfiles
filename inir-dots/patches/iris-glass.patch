+++ b/modules/iris/bar/island/IslandCompactColumn.qml	2026-11-01 20:28:26.709516487 +0100
@@ -74,7 +74,7 @@
         }
         IrisVisualizer {
             anchors.horizontalCenter: parent.horizontalCenter
-            running: column.island.playing && column.mode === "media" && !column.island.visualExpanded
+            running: column.island.playing && column.mode === "media" && !column.island.visualExpanded && !column.island.tucked
             tint: IrisStyle.visualizerTint(column.island.artTint)
             barHeight: 13 * column.d
         }
